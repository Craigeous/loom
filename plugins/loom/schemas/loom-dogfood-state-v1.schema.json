{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/craigeous/loom/schemas/loom-dogfood-state-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runId", "marker", "candidate", "dryFixture", "createdAt", "updatedAt", "phase", "roots"],
  "properties": {
    "schema": { "const": "loom-dogfood-state/v1" },
    "runId": { "type": "string", "minLength": 1 },
    "marker": { "type": "string", "minLength": 16 },
    "candidate": { "type": "string", "minLength": 7 },
    "dryFixture": { "type": "boolean" },
    "createdAt": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "phase": {
      "enum": [
        "idle",
        "prepared",
        "installed",
        "exercised",
        "uninstalled",
        "complete",
        "recovery-required",
        "quarantined",
        "infrastructure-blocked",
        "failed"
      ]
    },
    "substep": { "type": ["string", "null"] },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claudeHome", "codexHome", "project", "systemHome", "tmp"],
      "properties": {
        "claudeHome": { "type": "string", "minLength": 1 },
        "codexHome": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "systemHome": { "type": "string", "minLength": 1 },
        "tmp": { "type": "string", "minLength": 1 }
      }
    },
    "preInventoryHash": { "type": ["string", "null"] },
    "postInventoryHash": { "type": ["string", "null"] },
    "evidenceHash": { "type": ["string", "null"] },
    "quarantineReason": { "type": ["string", "null"] }
  }
}
